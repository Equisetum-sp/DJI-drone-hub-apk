<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/et_camerastream_targetip"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Input target IP address"
                android:maxLength="500"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_camerastream_rtsp_username"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Input RTSP username"
                android:maxLength="500"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_camerastream_targetip" />

            <EditText
                android:id="@+id/et_camerastream_rtsp_password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Input RTSP password"
                android:maxLength="500"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_camerastream_rtsp_username" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>